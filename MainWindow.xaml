<Window x:Class="BAR_Monobattles.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BAR_Monobattles"
        xmlns:viewmodel="clr-namespace:BAR_Monobattles"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        mc:Ignorable="d"
        Title="BAR Monobattles" Height="720" Width="1080">
    <Window.Resources>
        <BitmapImage x:Key="DefaultImage" UriSource="/Media/UnitIMGNotFound.jpg" />
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1.5">
                <GradientStop Color="Gray" Offset="0.30" />
                <GradientStop Color="DarkGray" Offset="0.45" />
                <GradientStop Color="SlateGray" Offset="0.50" />
                <GradientStop Color="Black" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
            <Grid  Margin="4,3,5,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="0.025*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#222275" Offset="0.10" />
                        <GradientStop Color="#2222a0" Offset="0.30" />
                        <GradientStop Color="#0f0fff" Offset="0.70" />
                        <GradientStop Color="#2200ff" Offset="1.0" />
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.5*"/>
                    <RowDefinition Height="0.15*"/>
                    <RowDefinition Height="0.15*"/>
                    <RowDefinition Height="0.75*"/>
                </Grid.RowDefinitions>
                <Image x:Name="T1_Image" Height="325" Grid.Row="0" 
                        Source="{Binding T1_Unit.UnitImage, 
                        FallbackValue={StaticResource DefaultImage}, 
                        TargetNullValue={StaticResource DefaultImage}}" 
                        ImageFailed="T1_Image_ImageFailed" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="100" Color="LightBlue"/>
                    </Image.Effect>
                </Image>
                <TextBox Grid.Row="1" Background="White" Width="250"
                    Text="{Binding T1_Unit.UnitName}" Style="{StaticResource UnitName}"/>
                <TextBox Grid.Row="2" Background="White" Width="300"
                    Text="{Binding T1_Unit.Building}"  Style="{StaticResource UnitBuilding}" TextWrapping="Wrap" />
                <TextBox Grid.Row="3" Background="White" Width="350" HorizontalAlignment="Left" BorderBrush="DarkGray" BorderThickness="3"
                    Text="{Binding T1_Unit.UnitDescription}"  FontSize="20" TextAlignment="Center" TextWrapping="WrapWithOverflow"
                         IsReadOnly="True"/>
            </Grid>
            <Grid Grid.Column="2" >
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#222275" Offset="0.10" />
                        <GradientStop Color="#2222a0" Offset="0.30" />
                        <GradientStop Color="#0f0fff" Offset="0.70" />
                        <GradientStop Color="#2200ff" Offset="1.0" />
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.5*"/>
                    <RowDefinition Height="0.15*"/>
                    <RowDefinition Height="0.15*"/>
                    <RowDefinition Height="0.75*"/>
                </Grid.RowDefinitions>
                <Image x:Name="T2_Image" Height="325" Grid.Row="0" 
                        Source="{Binding T2_Unit.UnitImage, 
                        FallbackValue={StaticResource DefaultImage}, 
                        TargetNullValue={StaticResource DefaultImage}}" 
                        ImageFailed="T2_Image_ImageFailed" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="100" Color="LightBlue"/>
                    </Image.Effect>
                </Image>
                <TextBox Grid.Row="1" Background="White" Width="250" 
                    Text="{Binding T2_Unit.UnitName}"  Style="{StaticResource UnitName}" />
                <TextBox Grid.Row="2" Background="White" Width="300" 
                    Text="{Binding T2_Unit.Building}"  Style="{StaticResource UnitBuilding}" TextWrapping="Wrap"/>
                <TextBox Grid.Row="3" Background="White" Width="350" HorizontalAlignment="Left" BorderBrush="DarkGray" BorderThickness="3"
                    Text="{Binding T2_Unit.UnitDescription}"  FontSize="20" TextAlignment="Center" TextWrapping="WrapWithOverflow"
                         IsReadOnly="True"/>
            </Grid>
        </Grid>
        <StackPanel Background="AliceBlue" Grid.Column="1">
            <StackPanel.Margin>
                10,5,0,5
            </StackPanel.Margin>
            
            <ComboBox x:Name="FactionCB" Margin="0,30,0,0" Width="300" FontSize="15"
                      SelectionChanged="FactionCB_SelectionChanged" 
                      SelectedValuePath="Content"
                      SelectedIndex="0"
                      IsEnabled="{Binding FactionCB_enabled}">
                <ComboBoxItem Content="Select Faction" IsEnabled="False" Visibility="Collapsed"/>
                <ComboBoxItem Content="Cortex"/>
                <ComboBoxItem Content="Armada"/>
                <ComboBoxItem Content="Legion"/>
                <ComboBoxItem Content="Random"/>
            </ComboBox>

            <ComboBox x:Name="TypeCB" Margin="0,15,0,0" Width="300" FontSize="15"
                      SelectionChanged="TypeCB_SelectionChanged"
                      SelectedValuePath="Content"
                      SelectedIndex="0"
                      IsEnabled="{Binding UnitTypeCB_enabled}">
                <ComboBoxItem Content="Select Type" IsEnabled="False" Visibility="Collapsed"/>
                <ComboBoxItem Content="Bots"/>
                <ComboBoxItem Content="Vehicles"/>
                <ComboBoxItem Content="Aircraft"/>
                <ComboBoxItem Content="Sea"/>
                <ComboBoxItem Content="Hover"/>
                <ComboBoxItem Content="Random"/>
            </ComboBox>
            
            <CheckBox x:Name="CheckAllowConstr" Margin="25,15,0,0" IsChecked="{Binding AllowContructors}">
                <TextBlock FontSize="15">
                    Include Constructors
                </TextBlock>
            </CheckBox>
            
            <CheckBox x:Name="CheckAllowZeroAtk" Margin="25,5,0,0" IsChecked="{Binding AllowZeroAttackUnits}">
                <TextBlock FontSize="15">
                    Include 0-Attack Units
                </TextBlock>
            </CheckBox>
            
            <Button x:Name="GenBtn" Content="Pick Units" Width="300" Height="50" Margin="5,200,5,0" 
                    FontSize="17" FontWeight="Bold" IsEnabled="{Binding RollUnitBtnEnabled}"
                    Click="GenBtn_Click"/>
            <StackPanel Orientation="Horizontal" Margin="0,25,0,0">
                <Button x:Name="Reroll_T1_Btn" Content="Reroll T1-Unit" Width="125" Height="50" HorizontalAlignment="Left" Margin="25,0,0,0"
                    FontSize="13" FontWeight="Bold"
                    IsEnabled="{Binding T1_RerollUnitBtnEnabled}"
                    Click="Reroll_T1_Btn_Click"/>

                <Button x:Name="Reroll_T2_Btn" Content="Reroll T2-Unit" Width="125" Height="50" HorizontalAlignment="Left" Margin="50,0,0,0"
                    FontSize="13" FontWeight="Bold"
                    IsEnabled="{Binding T2_RerollUnitBtnEnabled}"
                    Click="Reroll_T2_Btn_Click"/>
            </StackPanel>

            <Button x:Name="ResetBtn" Content="Reset" Width="125" Height="50" HorizontalAlignment="Left" Margin="115,25,0,0" Visibility="{Binding ResetVis}"
                    FontSize="13" FontWeight="Bold"  
                    Click="ResetBtn_Click"/>
        </StackPanel>
        
    </Grid>
</Window>
